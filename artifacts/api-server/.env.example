# Copy to `.env` for local API development. Do not commit real values.
# Production: set these in Railway (or your host), not in the repo.

# --- Server
PORT=3001
NODE_ENV=development

# PostgreSQL (required). Use your Supabase/Railway connection string.
DATABASE_URL=
# Set when your provider requires explicit TLS from Node (see lib/db).
# PGSSLMODE=require

# --- Sessions (required in production: long random string)
SESSION_SECRET=
# Optional (HTTPS dev / tunnel only): with NODE_ENV=development, Secure cookies need DEV_HTTPS_TUNNEL=1.
# Plain http://localhost — leave SESSION_COOKIE_SECURE unset (Secure cookies do not work on HTTP).
# SESSION_COOKIE_SECURE=1
# DEV_HTTPS_TUNNEL=1

# --- URLs (emails, redirects, CORS-related links in app)
# FRONTEND_URL=
# APP_URL=
# Production: extra allowed browser origins for credentialed API calls (comma-separated, exact https://host, no wildcards). Defaults include souq-arab.com + www.
# CORS_ALLOWED_ORIGINS=

# --- Email (Resend)
# RESEND_API_KEY=
# EMAIL_FROM=Souq Arab EU <no-reply@souq-arab.com>

# Optional default language for OTP / notification emails
# OTP_EMAIL_LANGUAGE=ar

# --- Supabase (server-side storage; never expose service role to the browser)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_UPLOADS_BUCKET=uploads

# --- OpenAI (optional; AI routes return 503 if unset)
# Prefer integration-style names on some hosts:
# AI_INTEGRATIONS_OPENAI_API_KEY=
# AI_INTEGRATIONS_OPENAI_BASE_URL=
# Or standard names:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# --- Admin bootstrap (optional; see ensure-app-settings / migrations)
# ADMIN_PASSWORD_HASH=
# ADMIN_SESSION_TTL_MS=
# Extra gate for admin login + admin APIs when set (non-empty). Send as header X-Admin-Access-Key on POST /api/admin-login only; never commit real values.
# ADMIN_ACCESS_KEY=
# Production-only: comma-separated client IPs allowed for admin login + /api/admin/* (+ related admin routes). Loopback always allowed. Leave unset or empty to disable.
# ADMIN_ALLOWED_IPS=
# Production: set to 1 only when the API sits behind Cloudflare (or similar) so CF-Connecting-IP is set by the edge, not spoofable by direct clients.
# If unset, CF-Connecting-IP is ignored and IP uses req.ip / socket (after trust proxy) — safer for direct origin access.
# TRUST_CLOUDFLARE_HEADERS=
# Production: set to 1 to use leftmost IP from X-Forwarded-For (only when Node sits behind a trusted reverse proxy that sets XFF correctly; never enable on untrusted direct access).
# TRUST_PROXY_IP_HEADERS=

# --- Logging
# LOG_LEVEL=info

# --- Observability (Phase 7A.5)
# SLOW_HTTP_MS=2000
# SLOW_DB_MS=500
# SLOW_SEARCH_MS=1000
# READYZ_DB_TIMEOUT_MS=3000
# OBSERVABILITY_LATENCY_SAMPLES=2000
# Admin JSON snapshot at GET /api/observability/metrics (admin session + IP gate). Default on; set 0 to hide.
# OBSERVABILITY_METRICS_ENABLED=0

# --- Sentry (error monitoring only — lazy-loaded when SENTRY_DSN is set)
# Copy DSN: Sentry → Settings → Client Keys (DSN)
# Local: pnpm run sentry:apply-dsn -- "https://....@....ingest.sentry.io/...."
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=   # optional; auto souq-api@<railway-git-sha> when unset

# --- Legacy / alternate object storage (optional)
# PUBLIC_OBJECT_SEARCH_PATHS=
# PRIVATE_OBJECT_DIR=
