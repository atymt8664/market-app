# PRODUCTION ONLY — /opt/souq-arab/config/api.env.production (chmod 600)
# Supabase ref MUST be production project only (see runbook) — never staging ref
# Fill values manually on VPS. Never commit real secrets. Do not symlink until cutover approval.

# --- Runtime (required)
NODE_ENV=
PORT=
PGSSLMODE=

# --- Database (required — Production Supabase pooler)
DATABASE_URL=

# --- Session (required)
SESSION_SECRET=
SESSION_COOKIE_SECURE=

# --- Public URLs (required for emails, redirects, CORS)
FRONTEND_URL=
APP_URL=
CORS_ALLOWED_ORIGINS=

# --- Supabase Storage (required)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_UPLOADS_BUCKET=

# --- Email / OTP (required for auth emails)
RESEND_API_KEY=
EMAIL_FROM=
OTP_EMAIL_LANGUAGE=

# --- Reverse proxy / client IP (VPS behind Nginx)
TRUST_PROXY_IP_HEADERS=
TRUST_CLOUDFLARE_HEADERS=

# --- Admin (recommended production)
ADMIN_ACCESS_KEY=
ADMIN_ALLOWED_IPS=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_TTL_MS=

# --- AI (optional — routes return 503 if unset)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=

# --- Observability (optional — sensible defaults if omitted)
LOG_LEVEL=
SLOW_HTTP_MS=
SLOW_DB_MS=
SLOW_SEARCH_MS=
READYZ_DB_TIMEOUT_MS=
OBSERVABILITY_LATENCY_SAMPLES=
OBSERVABILITY_METRICS_ENABLED=

# --- Sentry (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
GIT_COMMIT=

# --- Feature flags (optional)
USE_FTS_AD_SEARCH=
USE_DENORMALIZED_REACTION_COUNTERS=

# --- Legacy object storage (optional — prefer Supabase)
PUBLIC_OBJECT_SEARCH_PATHS=
PRIVATE_OBJECT_DIR=

# --- Production shadow / smoke (optional — VPS tests only)
PROD_SMOKE_EMAIL=
PROD_SMOKE_PASSWORD=

# --- Scale (Phase 8+ — optional)
REDIS_URL=
QUEUE_REDIS_URL=

# --- NEVER put STAGING_SMOKE_* or STAGING ref in this file
