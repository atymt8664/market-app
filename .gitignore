# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

# local secrets
.env
.env.*
!.env.example
!**/.env.example
!.env.*.example
!**/.env.*.example

# P1 security — never commit keys, exports, or ops dumps
**/.ssh-bootstrap/
*_ed25519
!*_ed25519.pub
*.pem
*.key
!*.key.example
scripts/exports/**
!scripts/exports/.gitkeep
**/db-export*/
**/*dump*.json
infra/hetzner/vps-foundation/*.log
infra/hetzner/**/*.log
!infra/hetzner/**/*.log.example

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

# Android Play upload keystore (Bubblewrap TWA) — never commit
play-distribution/twa/souq-twa-android/*.keystore
play-distribution/twa/souq-twa-android/*.jks

# Mis-copied local path / store screenshots accidentally dropped under souq (not app source)
artifacts/souq/UsersAbutymDownloads*

.vercel

# Release-excluded local artifacts (never commit)
.phase*-build-context.tgz
*.tgz
artifacts/souq/.lighthouse-*
artifacts/souq/.lh-*
artifacts/souq/.audit-*/
artifacts/souq/promo-video/
artifacts/souq/public/promo-video/
artifacts/souq/public/campaign-assets/
artifacts/souq/src/promo-video/
artifacts/souq/src/pages/promo-video.tsx
artifacts/souq/src/public/
google-play-publish-kit/
play-distribution/
artifacts/api-server/scripts/.phase*/
artifacts/api-server/scripts/_*
artifacts/souq/scripts/e2e-*
artifacts/souq/scripts/*-verify.mjs
artifacts/souq/scripts/*-audit.mjs
artifacts/souq/scripts/home-*
artifacts/souq/scripts/prod-smoke-*
artifacts/souq/scripts/phase8-*
artifacts/souq/scripts/compare-*
artifacts/souq/scripts/generate-*
!artifacts/souq/scripts/generate-notification-badge.mjs
artifacts/souq/scripts/gen-*
# Root scripts/ only — bare `scripts/` ignored artifacts/souq/scripts/ (build break on Vercel).
/scripts/
!artifacts/souq/scripts/assert-safe-frontend-api-env.mjs
