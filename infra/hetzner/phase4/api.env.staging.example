# STAGING ONLY — copy to /opt/souq-arab/config/api.env.staging (chmod 600). Never commit real values.
# Supabase project ref must be: qkczposlooaldmsjfmun

NODE_ENV=production
PORT=3001
PGSSLMODE=require
TRUST_PROXY_IP_HEADERS=1
PG_POOL_MAX=30

# Required
DATABASE_URL=
SESSION_SECRET=
FRONTEND_URL=
APP_URL=
CORS_ALLOWED_ORIGINS=

# Storage (STAGING Supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_UPLOADS_BUCKET=uploads

# Email (optional for OTP smoke)
RESEND_API_KEY=
EMAIL_FROM=

# VPS shadow over HTTP only — remove when serving HTTPS
SESSION_COOKIE_SECURE=0

SENTRY_ENVIRONMENT=staging-vps-shadow

# Web Push (P11) — generate on VPS only; never commit values
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:staging-push@souq-arab.eu
# REDIS_URL=redis://host.docker.internal:6379
# QUEUE_REDIS_URL=redis://host.docker.internal:6379

# Optional smoke credentials (staging seed user — set locally on VPS only)
# STAGING_SMOKE_EMAIL=
# STAGING_SMOKE_PASSWORD=
