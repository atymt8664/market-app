# Local frontend overrides only (copy to .env.local, gitignored)
# Point browser app to staging Supabase project, not production.

VITE_SUPABASE_URL=https://YOUR_STAGING_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_REPLACE_WITH_STAGING_ANON_KEY

# Keep empty to use Vite proxy (/api -> API_PROXY_TARGET)
# VITE_API_BASE_URL=

# Optional: explicit WebSocket HTTP origin when API is not same-origin (e.g. STAGING VPS direct test).
# Production default: same-origin /api/ws via Vercel rewrite — do not set unless debugging.
# VITE_WS_HTTP_ORIGIN=https://your-staging-api-host.example.com

# Optional for LAN debugging if API runs on another machine
# API_PROXY_TARGET=http://127.0.0.1:3001
