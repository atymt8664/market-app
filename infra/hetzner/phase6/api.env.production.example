# PRODUCTION ONLY — copy to /opt/souq-arab/config/api.env.production (chmod 600).
# Supabase project ref MUST be: nptfxtkedqndkgmrcntn
# Never commit real values. Never symlink until explicit cutover approval.

NODE_ENV=production
# Must be 3001 (container internal). Do not use 30001 — breaks :3002 shadow mapping.
PORT=3001
PGSSLMODE=require
TRUST_PROXY_IP_HEADERS=1
PG_POOL_MAX=30

# Required at cutover (fill manually on VPS)
DATABASE_URL=
SESSION_SECRET=
FRONTEND_URL=
APP_URL=
CORS_ALLOWED_ORIGINS=

# Storage (PRODUCTION Supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_UPLOADS_BUCKET=uploads

# Email
RESEND_API_KEY=
EMAIL_FROM=

# HTTPS required in production
SESSION_COOKIE_SECURE=1

SENTRY_ENVIRONMENT=production-vps

# Future scale (optional — enable in later phase)
# REDIS_URL=redis://127.0.0.1:6379
# QUEUE_REDIS_URL=redis://127.0.0.1:6379

# Do NOT add STAGING_SMOKE_* here.
