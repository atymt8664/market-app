# Local/staging overrides only (gitignored when copied to .env.local)
# Never put production secrets in this file.

# Required for local API runtime
PORT=3001
NODE_ENV=development

# Point to staging DB only (NOT production)
DATABASE_URL=postgresql://USER:PASSWORD@STAGING_HOST:6543/postgres?sslmode=require
SUPABASE_URL=https://YOUR_STAGING_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_WITH_STAGING_SERVICE_ROLE
SUPABASE_UPLOADS_BUCKET=uploads-staging

# Local frontend URL used in links/emails
FRONTEND_URL=http://127.0.0.1:5173
APP_URL=http://127.0.0.1:5173

# Local email provider config (staging/sandbox only)
RESEND_API_KEY=re_REPLACE_WITH_STAGING_KEY
EMAIL_FROM=Souq Arab EU <onboarding@resend.dev>

# P17-4 — enable real orders API against STAGING DB (mutations return 503 when off)
P17_ORDERS_API_ENABLED=1

# Safety guard (recommended)
# Allow remote DB in local dev only when you intentionally target staging.
ALLOW_REMOTE_DB_IN_DEV=1
# Comma-separated production host markers to hard-block in dev.
PRODUCTION_DB_HOST_PATTERNS=prod-db-host,prod-project-ref.pooler.supabase.com
PRODUCTION_SUPABASE_HOST_PATTERNS=prod-project-ref.supabase.co

# Emergency override only (keep unset)
# ALLOW_UNSAFE_LOCAL_ENV=1
