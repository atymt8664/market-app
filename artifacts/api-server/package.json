{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "set NODE_ENV=development&& pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "start:push-worker": "node --enable-source-maps ./dist/worker/push-worker.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ./src/lib/pagination.test.mjs && node ./src/lib/ad-search-util.test.mjs && node ./src/lib/ad-reaction-counts.test.mjs && node ./src/lib/ads-list-query.test.mjs && node ./src/lib/taxonomy-public-cache.test.mjs && node ./src/lib/push/notification-url.test.mjs && node ./src/lib/push/push-queue.test.mjs && node ./src/lib/observability/latency-tracker.test.mjs && node ./src/lib/observability/request-id.test.mjs && node ./src/lib/sentry.test.mjs && node ./src/lib/sentry-env.test.mjs",
    "sentry:apply-dsn": "node ./scripts/apply-sentry-dsn.mjs",
    "sentry:local-test": "node ./scripts/_sentry_local_test.mjs",
    "admin:reset-password": "node ./scripts/admin-reset-password.cjs"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.19.0",
    "@sentry/node": "8.55.2",
    "@supabase/supabase-js": "^2.104.1",
    "@types/multer": "^2.1.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "express-rate-limit": "^8.3.2",
    "express-session": "^1.19.0",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.1.0",
    "multer": "^2.1.1",
    "openai": "^6.34.0",
    "otplib": "^13.4.0",
    "pg": "^8.20.0",
    "pino": "^9",
    "pino-http": "^10",
    "qrcode": "^1.5.4",
    "redis": "^5.12.1",
    "resend": "^6.12.2",
    "sharp": "^0.34.5",
    "web-push": "^3.6.7",
    "ws": "^8.20.0",
    "zod": "catalog:"
